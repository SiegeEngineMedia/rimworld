<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.5+ (this machine has 1.6.4871) runs its mod-loaded C# assemblies against
    Unity's Mono/CoreCLR host at the .NET Standard 2.1 API level -- NOT modern net8.0/net10.0
    CoreCLR like glue's own runtimes/csharp (GlueCore/GlueFp/GlueServer, which multi-target
    net8.0;net10.0). A net8.0/net10.0 class library cannot be loaded in-process by RimWorld's
    host the way vintage-actors loads GlueCore.dll/GlueFp.dll directly (Vintage Story's own
    server process is itself modern .NET, so that in-process reference works there).
    GlueRimworld therefore stays on netstandard2.1 and talks to the glue engine
    OUT OF PROCESS over the glue-runtime-host HTTP transport (127.0.0.1, POST /api/execute)
    instead of referencing GlueCore/GlueFp/GlueServer assemblies directly. See
    Source/GlueBridgeClient.cs and NEXT_STEPS.md for the full rationale.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GlueRimworld</AssemblyName>
    <RootNamespace>GlueRimworld</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Assemblies\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Real local RimWorld install found on this machine; override via -p:RimWorldManagedDir=... elsewhere. -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GlueRimworldMod.cs" />
    <Compile Include="GlueBridgeClient.cs" />
    <Compile Include="PawnBehaviorBridge.cs" />
    <Compile Include="RimworldSeedCatalog.cs" />
  </ItemGroup>

  <!-- RimWorld / Unity assemblies -- real HintPaths against the installed game, not invented. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Harmony is provided at runtime by the separate "Harmony" mod (brrainz.harmony, see
    About/About.xml modDependencies) rather than bundled here -- the standard RimWorld
    modding convention, avoiding duplicate-Harmony-load AppDomain conflicts. This
    PackageReference is compile-time only (Private=false / ExcludeAssets=runtime) so no
    0Harmony.dll gets copied into Assemblies/.
  -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!--
      RimWorld's own Managed/ folder does not ship Newtonsoft.Json (verified against the
      installed 1.6.4871 Managed dir on this machine). Referenced at compile time only
      (Private=false / ExcludeAssets=runtime, same pattern as Harmony above) -- the ILRepack
      step below merges its IL directly into GlueRimworld.dll and internalizes its types, so
      no separate Newtonsoft.Json.dll is ever copied into Assemblies/. This closes the
      AppDomain-collision risk previously disclosed here and in NEXT_STEPS.md item 7 (another
      mod bundling a different Newtonsoft.Json version can no longer collide with this one,
      since this one is never a standalone loadable assembly to begin with).
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!--
      ILRepack.Lib.MSBuild.Task drives the merge below (MSBuild-integrated ILRepack, no
      separate CLI tool/install step needed). Build-time only.
    -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Merge Newtonsoft.Json.dll into GlueRimworld.dll and internalize its types (ILRepack
    /internalize), then overwrite the primary output with the merged assembly. Runs after
    Build so $(TargetPath) (GlueRimworld.dll in $(OutputPath) = ../Assemblies/) already
    exists and Newtonsoft.Json.dll has already been resolved into $(TargetDir) by the
    PackageReference above (ExcludeAssets=runtime keeps it out of the FINAL Assemblies/
    output, but it is still present in the intermediate build output ILRepack reads from).
    Unconditional /internalize (no exclude list) is deliberate: GlueRimworld's own code
    (GlueBridgeClient.cs et al.) is the only consumer of Newtonsoft.Json's public API here,
    so nothing outside this assembly needs those types to stay public.
  -->
  <Target Name="ILRepackNewtonsoftJson" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ILRepackInputAssembly Include="$(TargetPath)" />
      <ILRepackInputAssembly Include="$(IntermediateOutputPath)Newtonsoft.Json.dll" Condition="Exists('$(IntermediateOutputPath)Newtonsoft.Json.dll')" />
      <ILRepackInputAssembly Include="$(OutDir)Newtonsoft.Json.dll" Condition="'@(ILRepackInputAssembly)' == '$(TargetPath)' And Exists('$(OutDir)Newtonsoft.Json.dll')" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      Internalize="true"
      DebugInfo="true"
      InputAssemblies="@(ILRepackInputAssembly)"
      OutputFile="$(TargetPath)"
      TargetKind="Dll"
      LibraryPath="$(OutDir);$(RimWorldManagedDir)" />
    <Delete Files="$(OutDir)Newtonsoft.Json.dll" Condition="Exists('$(OutDir)Newtonsoft.Json.dll')" />
  </Target>

</Project>
